{
  "name": "rocky",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "copy-cesium": "node -e \"const fs=require('fs');for (const d of ['Workers','ThirdParty','Assets','Widgets']) fs.cpSync('node_modules/cesium/Build/Cesium/'+d,'public/cesium/'+d,{recursive:true})\"",
    "predev": "npm run copy-cesium",
    "prebuild": "npm run copy-cesium"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@react-three/fiber": "^9.1.2",
    "@types/leaflet": "^1.9.12",
    "cesium": "^1.146.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
